# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key
API_KEY=change-me-to-a-random-api-key

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./fordaq_agent.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/fordaq_agent

# ── Redis (optional, for task queue) ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Vapi (Voice AI platform) ─────────────────────────────────────────
VAPI_API_KEY=your-vapi-api-key-here
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
VAPI_ASSISTANT_ID=your-vapi-assistant-id
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret

# ── Retell (alternative voice platform) ──────────────────────────────
RETELL_API_KEY=your-retell-api-key-here
RETELL_AGENT_ID=your-retell-agent-id
RETELL_PHONE_NUMBER=+1234567890

# ── Google Sheets ─────────────────────────────────────────────────────
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEETS_LEAD_SHEET_ID=your-google-sheet-id-here
GOOGLE_SHEETS_LEAD_TAB=Leads
GOOGLE_SHEETS_CALL_LOG_TAB=Call Log
GOOGLE_SHEETS_REPORT_TAB=Daily Report

# ── Anthropic Claude (for scoring + summaries) ────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Calling config ────────────────────────────────────────────────────
VOICE_PROVIDER=vapi
# Options: vapi | retell | twilio
MAX_CALLS_PER_DAY=100
CALL_START_HOUR=9
CALL_END_HOUR=18
RETRY_NO_ANSWER_AFTER_HOURS=24
MAX_CALL_RETRIES=3
CALL_TIMEOUT_SECONDS=60

# ── Compliance ────────────────────────────────────────────────────────
COMPANY_NAME=Fordaq
IDENTIFY_AS=Fordaq Lead Activation Team
CALLER_ID_NAME=Fordaq
OPT_OUT_PHRASE=stop calling
GDPR_MODE=true

# ── Webhook base URL (your public server URL) ─────────────────────────
PUBLIC_BASE_URL=https://your-domain.com
